{# @var sample \App\Localingo\Domain\Sample\Sample #}

{% extends 'base.html.twig' %}

{% block title %}LocaLingo episode!{% endblock %}

{% block card %}
    <div class="card bg-light card-exercise">
        {{ form_start(form) }}
        <div class="card-header border-0">
            &nbsp;
        </div>
        {{ form_row(form.translation) }}
        {{ form_row(form.declined) }}
        {{ form_row(form.word) }}
        {{ form_row(form.gender) }}
        {{ form_row(form.state) }}
        {{ form_row(form.case) }}
        {{ form_row(form.next) }}
        {{ form_end(form) }}

        {% if chars is not empty %}
            {% include '_exercise_card_chars.html.twig' with {'chars': chars} %}
        {% endif %}

        <div class="card-footer">
            <a href="#" class="card-link">Grammar tables</a>
        </div>
    </div>
{% endblock %}
