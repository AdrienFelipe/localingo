{# @var sample \App\Localingo\Domain\Sample\Sample #}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}LocaLingo!{% endblock %}</title>

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
</head>
<body>
<main class="container py-3">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-auto">
            {% block card %}{% endblock %}
        </div>
    </div>
</main>

{% block javascripts %}
    {{ encore_entry_script_tags('app') }}
{% endblock %}
</body>
</html>
