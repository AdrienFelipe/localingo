
<!DOCTYPE html>
<html lang="en">
<head>

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}


    <meta charset="UTF-8">
    <title>{% block title %}LocaLingo!{% endblock %}</title>

    <div class="container">
        <div class="row justify-content-center mt-4">
            <div class="col-auto">
                <div class="card bg-light" style="width: 20rem;">
                    <div class="card-header">
                        Episode completed
                    </div>
                    <div class="card-body bg-white text-center">
                        <svg class="text-success" width="100" height="100" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"
                             role="img" aria-label="Completed">
                            <path d="M4 12.5 9.5 18 20 6"/>
                        </svg>
                        <p class="fs-2 text-secondary">Great job!</p>
                    </div>
                    <div class="p-2 d-grid border-top">
                        <a class="btn-success btn" href="/">Start new?</a>
                    </div>
                    <div class="card-footer">
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}

</head>
<body>
{% block body %}{% endblock %}
</body>
</html>
