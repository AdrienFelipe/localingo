<?xml version="1.0"?>
<!-- Unused code detection is off: services are wired by the DI container and
     called from Twig, so Psalm cannot see those usages. -->
<psalm errorLevel="1" findUnusedCode="false">
    <projectFiles>
        <directory name="src" />
        <ignoreFiles>
            <directory name="frameworks" />
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <!-- The app advertises being extendable to other languages and frameworks,
             so sealing every class is a design call, not a lint fix. -->
        <ClassMustBeFinal errorLevel="suppress"/>
    </issueHandlers>
</psalm>
