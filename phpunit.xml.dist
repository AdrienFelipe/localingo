<?xml version="1.0" encoding="UTF-8"?>
<!-- https://phpunit.de/manual/current/en/appendixes.configuration.html -->
<phpunit
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
        colors="true"
        bootstrap="active-framework/tests/bootstrap.php"
        cacheDirectory="active-framework/var/cache/.phpunit.cache"
>
  <source>
    <include>
      <directory>./src/</directory>
    </include>
  </source>
  <php>
    <ini name="error_reporting" value="-1"/>
    <env name="APP_ENV" value="test"/>
    <env name="SHELL_VERBOSITY" value="-1"/>
    <env name="SYMFONY_DEPRECATIONS_HELPER" value="7"/>
  </php>
  <testsuites>
    <testsuite name="localingo Test Suite">
      <directory>tests/</directory>
    </testsuite>
  </testsuites>
  <!--<logging>
        <log type="coverage-html" target="report/html"/>
    </logging>-->
  <extensions>
    <bootstrap class="App\Tests\Shared\Infrastructure\Phpunit\SessionTestHook"/>
    <bootstrap class="App\Tests\Shared\Infrastructure\Phpunit\RepositoryTestHook"/>
    <bootstrap class="App\Tests\Shared\Infrastructure\Phpunit\FileTestHook"/>
  </extensions>
</phpunit>
